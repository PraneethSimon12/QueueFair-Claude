# Docker Compose overrides. Copy to .env (gitignored) to replace the dev defaults baked into
# docker-compose.yml. Compose has working defaults, so `docker compose up` works WITHOUT this file
# — but never ship these values anywhere real.

# The shared HS256 admission secret. MUST be byte-identical for the queue (signs) and booking
# (verifies) services — compose feeds this one value to both. >= 32 bytes.
ADMISSION_TOKEN_SECRET=dev-shared-admission-secret-change-me-32b

DB_PASSWORD=queuefair
DJANGO_SECRET_KEY=dev-insecure-change-me
